# ═══════════════════════════════════════════════════════════════════════════
# AI Command Center — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# On Windows (PowerShell):
#   Copy-Item .env.example .env
# ═══════════════════════════════════════════════════════════════════════════

# ── HuggingFace ───────────────────────────────────────────────────────────
# Get yours at https://huggingface.co/settings/tokens
# Requires "read" access for gated models (Llama 3.1, FLUX.1) and "write"
# if you want to push fine-tuned models back to the Hub.
HF_TOKEN=hf_YOUR_TOKEN_HERE

# ── GitHub (optional — used by SystemAgent to push code) ──────────────────
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# ── Orchestrator (fine-tuned 70B GGUF) ────────────────────────────────────
# Path to your QLoRA fine-tuned + GGUF quantized model.
# After running notebooks/02_quantize_export.ipynb, download the GGUF:
#   huggingface-cli download YOUR-USERNAME/llama31-70b-uncensored-GGUF \
#       llama31-70b-uncensored-Q4_K_M.gguf --local-dir C:\AI-models\
ORCHESTRATOR_MODEL_PATH=C:\AI-models\llama31-70b-uncensored-Q4_K_M.gguf
ORCHESTRATOR_N_GPU_LAYERS=28
ORCHESTRATOR_N_CTX=4096
ORCHESTRATOR_N_THREADS=24
ORCHESTRATOR_TEMPERATURE=0.7
ORCHESTRATOR_MAX_TOKENS=2048

# ── Code agent (DeepSeek-R1 8B GGUF — fits entirely on RTX 5090) ──────────
CODE_MODEL_PATH=C:\AI-models\DeepSeek-R1-Distill-Llama-8B-Q8_0.gguf
CODE_N_GPU_LAYERS=99

# ── Text-to-image (FLUX.1-dev via diffusers) ──────────────────────────────
# FLUX.1-dev requires HF token + license acceptance at:
#   https://huggingface.co/black-forest-labs/FLUX.1-dev
T2I_MODEL_ID=black-forest-labs/FLUX.1-dev
T2I_DEVICE=cuda

# ── Text-to-video (CogVideoX-5b via diffusers) ────────────────────────────
T2V_MODEL_ID=THUDM/CogVideoX-5b
T2V_DEVICE=cuda
T2V_NUM_FRAMES=49
T2V_FPS=8

# ── VLM (Qwen2-VL-7B-Instruct) ────────────────────────────────────────────
# Loads in 4-bit quantization by default (~4 GB VRAM) if bitsandbytes is
# installed, otherwise full precision (~16 GB).
VLM_MODEL_ID=Qwen/Qwen2-VL-7B-Instruct
VLM_DEVICE=cuda

# ── RAG index ─────────────────────────────────────────────────────────────
# Point RAG_DOCS_DIR at your Google Drive sync folder containing documents.
# The index is stored alongside the docs (or wherever RAG_INDEX_DIR points).
RAG_DOCS_DIR=C:\Users\Administrator\Documents
RAG_INDEX_DIR=C:\Users\Administrator\Documents\rag_index
RAG_EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=6

# ── Output directories ────────────────────────────────────────────────────
OUTPUT_DIR=C:\AI-command-center\outputs

# ── System agent safety ──────────────────────────────────────────────────
# The system agent sandboxes file operations to this root directory.
# Set to a broader path if you want the agent to access more of your system.
# SYSTEM_AGENT_ALLOWED_ROOT=C:\Users\Administrator

# ── UI ────────────────────────────────────────────────────────────────────
GRADIO_PORT=7860
GRADIO_SHARE=false
